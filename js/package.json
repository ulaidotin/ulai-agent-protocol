{
  "name": "ulai-agent-protocol",
  "version": "0.2.0",
  "description": "Generated protobuf code for the Ulai agent API (ulai.agent.v1)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ulaidotin/ulai-agent-protocol.git",
    "directory": "js"
  },
  "homepage": "https://github.com/ulaidotin/ulai-agent-protocol/tree/main/js",
  "bugs": {
    "url": "https://github.com/ulaidotin/ulai-agent-protocol/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./ulai/agent/v1": {
      "types": "./ulai/agent/v1/agent_pb.d.ts",
      "default": "./ulai/agent/v1/agent_pb.js"
    }
  },
  "files": [
    "ulai/**/*.js",
    "ulai/**/*.d.ts"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  }
}
